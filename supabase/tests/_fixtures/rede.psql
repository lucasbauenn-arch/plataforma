-- ============ CONSENTIMENTOS (termos vigentes da semente da 02) ============
insert into public.lgpd_consentimentos (titular, profile_id, termo_id, origem)
select 'parceiro', pg_temp.usuario(n), public._termo_vigente_id('termos_parceiro'), 'cadastro_parceiro'
from unnest(array['ia', 'ga1', 'ga2', 'ca1a', 'ca2a', 'ib', 'gb1', 'cb1a', 'inativo', 'bloqueado']) n;

insert into public.lgpd_consentimentos (titular, cliente_id, termo_id, origem, registrado_por)
select 'cliente', pg_temp.cliente(x.c), public._termo_vigente_id('consentimento_cliente'), 'declarado', pg_temp.usuario(x.quem)
from (values ('c1', 'ca1a'), ('c2', 'ca2a'), ('c3', 'cb1a'), ('c4', 'ga1'), ('c5', 'bloqueado')) as x(c, quem);

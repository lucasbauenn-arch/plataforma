-- desligamento (como rede_inativar_parceiro faria): vínculo inativado, perfil 'inativo'; bloqueio: só o perfil
set local arken.motivo_vinculo = 'fixture: desligamento';
update public.parceiros set inativado_em = now(), motivo_inativacao = 'fixture: desligamento'
 where id = pg_temp.parceiro('inativo');
set local arken.motivo_vinculo = '';
update public.profiles set status_parceiro = 'inativo' where id = pg_temp.usuario('inativo');
update public.profiles set status_parceiro = 'bloqueado' where id = pg_temp.usuario('bloqueado');

